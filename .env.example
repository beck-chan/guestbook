# Feature flag toggles
FLAG_DOCS=true # Show docs link
FLAG_COUNTER=true # Show hit counter
FLAG_PUBLIC=false # Show public guestbook home/public repo + dark green favicon

# Project URL. Local + GitHub Actions (keep-alive) + Vercel.
NEXT_PUBLIC_SUPABASE_URL=

# Anon / public key (browser-safe; RLS still applies). Local + GitHub Actions + Vercel.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role. Local only — npm run allow-admin. Never GitHub, never Vercel, never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# App origin for OAuth return. Server-only (no NEXT_PUBLIC_). Used to build redirectTo on the server.
# Local: http://localhost:3000 (other port if both apps run). Vercel: https:// your live host.
# Not used by keep-alive (do not put on GitHub).
SITE_URL=http://localhost:3000

# Supabase pooler URI. Local + Vercel after rate limiting (subplan 3). Not on GitHub.
DATABASE_URL=
