# Feature flag toggles
FLAG_DOCS=true # Show docs link
FLAG_COUNTER=true # Show hit counter
FLAG_COUNTER_URL=https://beck-chan.vercel.app,https://y2k-guestbook.vercel.app # Comma-separated paths/URLs for unique visitors (empty = all pages)
FLAG_PUBLIC=false # Show public guestbook home/public repo + dark green favicon

# PostHog client (safe to expose; used by posthog-js)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# PostHog Query API (server-only; never NEXT_PUBLIC_)
# Personal key needs query:read only.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_API_HOST=https://us.posthog.com

# Supabase project URL. 
#Local + GitHub Actions (keep-alive) + Vercel.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable API key (browser-safe, RLS still applies). # Local + GitHub Actions + Vercel.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role API key. 
# Local ONLY — for `npm run allow-admin`
SUPABASE_SERVICE_ROLE_KEY=

# App origin for OAuth return. Server-only (no NEXT_PUBLIC_). Used to build redirectTo on the server.
# Local: http://localhost:3000 (other port if both apps run).  
# Vercel/deployment: https:// your live host.
SITE_URL=http://localhost:3000

# Supabase Postgres pooler URI (Transaction or Session mode) for rate-limiter-flexible.
# Local + Vercel. Example: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Prefer Session mode (port 5432) if Transaction mode (6543) misbehaves; the app strips prepared-statement names either way.
DATABASE_URL=
